generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model SurveyResponse {
  id          String   @id @default(cuid())
  age         Int
  gender      String
  job         String
  otherJob    String?
  services    String[]
  persyaratan Int
  prosedur    Int
  waktu       Int
  biaya       Int
  produk      Int
  kompetensi  Int
  perilaku    Int
  pengaduan   Int
  fasilitas   Int
  feedback    String?
  createdAt   DateTime @default(now())

  @@map("survey_responses")
}

model ContactMessage {
  id        String   @id @default(cuid())
  nama      String
  email     String
  pesan     String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model News {
  id        String   @id @default(cuid())
  judul     String
  ringkasan String
  isi       String
  kategori  String
  tanggal   DateTime @default(now())
  penulis   String
  gambar    String?
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tanggal])
  @@index([kategori])
  @@map("news")
}
